# ==============================
# Clerk Authentication
# ==============================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ==============================
# Stripe Payments
# ==============================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=price_xxxxx
NEXT_PUBLIC_STRIPE_YEARLY_PRICE_ID=price_xxxxx

# ==============================
# Supabase Database
# ==============================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyxxxxx
# New Supabase projects should prefer SUPABASE_SECRET_KEY=sb_secret_xxx.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=eyxxxxx

# ==============================
# Google Analytics
# ==============================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ==============================
# App Config
# ==============================
NEXT_PUBLIC_APP_URL=https://nowbuild.ai
NEXT_PUBLIC_APP_NAME=NowBuild
# Production Agent APIs fail closed when Clerk is unavailable. Set this only
# for a deliberately public, non-production demo deployment.
ALLOW_UNAUTHENTICATED_AGENT_DEMO=false

# ==============================
# OpenRouter AI
# 留空时进入 Mock 演示模式：对话/策略/To-Do 全流程用内置示例数据跑通
# ==============================
OPENROUTER_API_KEY=sk-or-v1-xxxxx
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_FALLBACK_MODELS=openai/gpt-5-mini,deepseek/deepseek-v4-pro

# Product and competitor research
# Firecrawl reads the product site and selected competitor sites.
# Tavily discovers likely competitors before their sites are inspected.
FIRECRAWL_API_KEY=fc-xxxxx
TAVILY_API_KEY=tvly-xxxxx

# Per-user monthly AI budget. At the soft limit, new calls use the budget
# fallback model. At the hard limit, new calls are rejected until next month.
AI_MONTHLY_SOFT_LIMIT_USD=6
AI_MONTHLY_HARD_LIMIT_USD=8
AI_BUDGET_FALLBACK_MODEL=openai/gpt-5-mini

# OpenRouter passes inference through at provider list price, but charges this
# fee when credits are purchased. Including it keeps internal costs conservative.
OPENROUTER_CREDIT_FEE_RATE=0.055
