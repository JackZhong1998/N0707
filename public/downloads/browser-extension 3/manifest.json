{
  "manifest_version": 3,
  "name": "NowBuild Publisher",
  "description": "Fill publishing and product-directory forms in your existing browser sessions, then collect public performance data.",
  "version": "0.7.0",
  "icons": {
    "16": "assets/nowbuild-logo-16.png",
    "32": "assets/nowbuild-logo-32.png",
    "48": "assets/nowbuild-logo-48.png",
    "128": "assets/nowbuild-logo-128.png"
  },
  "permissions": [
    "debugger",
    "scripting",
    "storage",
    "tabGroups",
    "tabs",
    "windows"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://creator.xiaohongshu.com/*",
    "https://www.xiaohongshu.com/*",
    "https://xhslink.com/*",
    "https://*.xhslink.com/*",
    "https://news.ycombinator.com/*",
    "https://dev.to/*",
    "https://reddit.com/*",
    "https://*.reddit.com/*",
    "https://linkedin.com/*",
    "https://*.linkedin.com/*",
    "https://medium.com/*",
    "https://*.medium.com/*",
    "https://hashnode.com/*",
    "https://*.hashnode.com/*",
    "https://hashnode.dev/*",
    "https://*.hashnode.dev/*",
    "https://indiehackers.com/*",
    "https://*.indiehackers.com/*",
    "https://uneed.best/*",
    "https://*.uneed.best/*",
    "https://peerpush.com/*",
    "https://*.peerpush.com/*",
    "https://openhunts.com/*",
    "https://*.openhunts.com/*",
    "https://toolfio.com/*",
    "https://*.toolfio.com/*",
    "https://earlyhunt.com/*",
    "https://*.earlyhunt.com/*",
    "https://twelve.tools/*",
    "https://*.twelve.tools/*",
    "https://nowbuild.ai/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "NowBuild Publisher",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/nowbuild-logo-16.png",
      "32": "assets/nowbuild-logo-32.png",
      "48": "assets/nowbuild-logo-48.png",
      "128": "assets/nowbuild-logo-128.png"
    }
  },
  "options_page": "test-console/index.html",
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://nowbuild.ai/*",
        "https://*.nowbuild.ai/*"
      ],
      "js": [
        "web-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "channels/x-text.js",
        "channels/x.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://creator.xiaohongshu.com/*",
        "https://www.xiaohongshu.com/*",
        "https://xhslink.com/*",
        "https://*.xhslink.com/*"
      ],
      "js": [
        "channels/xiaohongshu.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://news.ycombinator.com/*",
        "https://dev.to/*",
        "https://reddit.com/*",
        "https://*.reddit.com/*",
        "https://linkedin.com/*",
        "https://*.linkedin.com/*",
        "https://medium.com/*",
        "https://*.medium.com/*",
        "https://hashnode.com/*",
        "https://*.hashnode.com/*",
        "https://hashnode.dev/*",
        "https://*.hashnode.dev/*",
        "https://indiehackers.com/*",
        "https://*.indiehackers.com/*"
      ],
      "js": [
        "channels/common.js",
        "channels/platforms.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://uneed.best/*",
        "https://*.uneed.best/*",
        "https://peerpush.com/*",
        "https://*.peerpush.com/*",
        "https://openhunts.com/*",
        "https://*.openhunts.com/*",
        "https://toolfio.com/*",
        "https://*.toolfio.com/*",
        "https://earlyhunt.com/*",
        "https://*.earlyhunt.com/*",
        "https://twelve.tools/*",
        "https://*.twelve.tools/*"
      ],
      "js": [
        "channels/common.js",
        "directories/catalog.js",
        "directories/adapter.js",
        "directories/recorder.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
